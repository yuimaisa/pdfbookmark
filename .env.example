# Copy this file to .env and keep real API keys out of Git, issues, and logs.
# The bundled sample works without an API key.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Optional live test: RUN_DEEPSEEK_TESTS=1

# Optional OpenAI settings (only used when OpenAI is selected in the sidebar)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# Optional live test: RUN_OPENAI_TESTS=1
