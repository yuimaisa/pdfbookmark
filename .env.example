DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Optional live test: RUN_DEEPSEEK_TESTS=1

# Optional OpenAI settings (only used when OpenAI is selected in the sidebar)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# Optional live test: RUN_OPENAI_TESTS=1

# Optional local OCR cache location (contains recognized book text)
# PDFBOOKMARK_CACHE_DIR=/path/to/private/cache
# Optional Paddle model cache location
# PADDLE_PDX_CACHE_HOME=/path/to/paddle-models
# Optional local OCR integration tests: RUN_OCR_TESTS=1
